# ============================================
# PROSPECTING OS — Environment Variables
# Copy this file to .env.local and fill values
# ============================================

# ─── Supabase ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Apify ───────────────────────────────────────────
APIFY_API_KEY=your-apify-token
APIFY_ACTOR_ID=x_guru~Leads-Scraper-apollo-zoominfo
APIFY_LINKEDIN_ACTOR_ID=your-linkedin-actor-id

# ─── AI Models ───────────────────────────────────────
ANTHROPIC_API_KEY=your-claude-key
GEMINI_API_KEY=your-gemini-key
DEEPSEEK_API_KEY=your-deepseek-key

# ─── Email (Resend) ──────────────────────────────────
RESEND_API_KEY=your-resend-key
RESEND_WEBHOOK_SECRET=your-resend-webhook-secret
NOTIFY_EMAIL=founder@example.com

# ─── Telegram ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=your-bot-token

# ─── Payments (Dodo) ─────────────────────────────────
DODO_WEBHOOK_SECRET=your-webhook-secret
DODO_MICRO_PAYMENT_LINK=https://pay.dodo.com/...
DODO_PILOT_PAYMENT_LINK=https://pay.dodo.com/...
DODO_GROWTH_PAYMENT_LINK=https://pay.dodo.com/...
DODO_SCALE_PAYMENT_LINK=https://pay.dodo.com/...

# ─── Legacy Payment Links ────────────────────────────
EASEBUZZ_MICRO_URL=
EASEBUZZ_PILOT_URL=
EASEBUZZ_GROWTH_URL=
EASEBUZZ_SCALE_URL=
SKYDO_MICRO_URL=
SKYDO_PILOT_URL=
SKYDO_GROWTH_URL=
SKYDO_SCALE_URL=
STRIPE_PAYMENT_LINK_MICRO=
STRIPE_PAYMENT_LINK_PILOT=
STRIPE_PAYMENT_LINK_GROWTH=
STRIPE_PAYMENT_LINK_SCALE=

# ─── Bank Details ────────────────────────────────────
# Server-side (API routes)
BANK_NAME=JPMorgan Chase Bank, N.A
BANK_ACCOUNT_NUMBER=REPLACE_WITH_ACTUAL
BANK_ROUTING_NUMBER=REPLACE_WITH_ACTUAL
# Client-side (checkout UI — NEXT_PUBLIC_ = visible in browser)
NEXT_PUBLIC_BANK_NAME=JPMorgan Chase Bank, N.A
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=REPLACE_WITH_ACTUAL
NEXT_PUBLIC_BANK_ROUTING_NUMBER=REPLACE_WITH_ACTUAL

# ─── Cron ────────────────────────────────────────────
CRON_SECRET=your-cron-secret

# ─── Google ──────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALENDAR_REFRESH_TOKEN=your-refresh-token
GOOGLE_MAPS_API_KEY=your-maps-key

# ─── Outreach ────────────────────────────────────────
GMAPS_RUNNER_SECRET=your-runner-secret
OPENOUTREACH_URL=http://localhost:3000
VERCEL_URL=your-vercel-url

# ─── Analytics ───────────────────────────────────────
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=your-clarity-id
NEXT_PUBLIC_META_PIXEL_ID=your-pixel-id
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=your-linkedin-partner-id

# ─── Security ────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-key
NEXT_PUBLIC_SITE_URL=https://app.flow-forges.com/prospecting-os

# ─── Monitoring ──────────────────────────────────────
SENTRY_DSN=your-sentry-dsn
