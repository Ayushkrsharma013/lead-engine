# ============================================================================
# Prospecting OS — Test Environment Variables
# Copy this file to tests/.env and fill in the values.
# ============================================================================

# ─── Supabase (Production Project) ───────────────────────────────────────────
# Used for API-level tests (E2E, security scans). The test suite also uses
# a local SQLite DB (tests/db/test-environment.db) for assertions and monitoring.
NEXT_PUBLIC_SUPABASE_URL=https://tbsqpnqzpbnilifhwvgr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ─── App URL ─────────────────────────────────────────────────────────────────
# Where the app is running (local dev or deployed preview)
APP_URL=http://localhost:3000
# APP_URL=https://app.flow-forges.com

# ─── Test Credentials ────────────────────────────────────────────────────────
# Super admin account for admin-level tests
TEST_SUPERADMIN_EMAIL=admin@flow-forges.com
TEST_SUPERADMIN_PASSWORD=your-admin-password-here

# Password used when creating test users programmatically
TEST_USER_PASSWORD=test-password-123!

# ─── API Secrets ─────────────────────────────────────────────────────────────
# Dodo Payments webhook secret (for signature verification tests)
DODO_WEBHOOK_SECRET=your-dodo-webhook-secret

# Cron secret for internal API calls (lead generation trigger)
CRON_SECRET=your-cron-secret

# ─── Optional: Monitoring & Alerts ───────────────────────────────────────────
# Vercel API token (for log anomaly detection)
VERCEL_TOKEN=

# Vercel project/team IDs (optional — auto-detected if not set)
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Telegram bot for alert notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Optional: Mock Payment Server ───────────────────────────────────────────
MOCK_PAYMENT_PORT=3456
MOCK_PAYMENT_URL=http://localhost:3456

# ─── Optional: Test Workspace ────────────────────────────────────────────────
# Pre-existing workspace ID for lead generation monitoring tests
TEST_WORKSPACE_ID=
