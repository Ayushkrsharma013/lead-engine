{
  "name": "prospecting-os-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Comprehensive testing suite for Prospecting OS — E2E, security, monitoring",
  "scripts": {
    "test:e2e": "npx cucumber-js tests/e2e/features/**/*.feature --require tests/e2e/steps/**/*.ts --require-module ts-node/register --format @cucumber/pretty-formatter",
    "test:e2e:playwright": "npx playwright test --config tests/e2e/playwright.config.ts",
    "test:security": "npx ts-node tests/security/rls_policy_tester.spec.ts && npx ts-node tests/security/api_injection_tester.ts && npx ts-node tests/security/payment_bypass_tester.ts",
    "test:security:rls": "npx ts-node tests/security/rls_policy_tester.spec.ts",
    "test:security:injection": "npx ts-node tests/security/api_injection_tester.ts",
    "test:security:payment": "npx ts-node tests/security/payment_bypass_tester.ts",
    "test:monitoring:performance": "npx ts-node tests/monitoring/performance_tracker.ts",
    "test:monitoring:metrics": "npx ts-node tests/monitoring/metrics_alerter.ts",
    "test:monitoring:anomaly": "python3 tests/monitoring/anomaly_detector.py",
    "test:ci": "npm run test:security && npm run test:e2e:playwright"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.0",
    "@cucumber/pretty-formatter": "^1.0.0",
    "@playwright/test": "^1.45.0",
    "@supabase/supabase-js": "^2.105.4",
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "better-sqlite3": "^12.0.0",
    "express": "^4.21.0",
    "playwright": "^1.45.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
